# ============================================
# BACKEND ENVIRONMENT VARIABLES (TEMPLATE)
# Copy this to .env and fill in your own real values.
# NEVER commit the actual .env file to GitHub.
# ============================================

NODE_ENV=production
PORT=10000

# MongoDB Atlas (free tier) — get from Atlas dashboard
MONGO_URI=

# JWT Secrets — generate long random strings, do NOT reuse example values
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Admin credentials (used by seed.js only, to create the first admin user)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Gmail (use an App Password, not your real Gmail password)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Comma-separated list of frontend URLs allowed to call this API
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# Your deployed backend URL (used to build image URLs)
API_BASE_URL=https://your-backend.onrender.com

UPLOAD_DIR=public/uploads
MAX_FILE_SIZE=5242880

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Groq (free) — get key from https://console.groq.com
GROQ_API_KEY=
CHATBOT_MODEL=llama-3.3-70b-versatile
CHATBOT_TEMPERATURE=0.3
CHATBOT_MAX_CONTEXT=5